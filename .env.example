# ─────────────────────────────────────────────
# أكله بمزاج (MAZAG) · متغيرات البيئة
# انسخ الملف باسم .env.local وعبّي القيم.
# ملفات .env* كلها مقفولة في .gitignore ولا تُنشر أبدًا.
# ─────────────────────────────────────────────

# --- حماية لوحة التحكم ---
# كلمة سر دخول /admin/login (fallback شغال: mazag2026 — غيّرها قبل النشر)
ADMIN_PASSWORD=
# نص عشوائي طويل لتوقيع كوكي الجلسة (openssl rand -hex 32)
ADMIN_COOKIE_SECRET=

# --- إشعارات واتساب (اختياري) ---
# رقم الأدمن لاستقبال إشعارات الطلبات — صيغة دولية بدون + مثل 201012345678
ADMIN_WHATSAPP=
# Meta Cloud API — من غيره الإشعار بيفتح wa.me يدوي من اللوحة
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
