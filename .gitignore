# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# runtime data store (orders + menu overrides) — server only, never publish
/.data/

# vercel
.vercel

# admin uploads (runtime files, not source)
/public/uploads/

# QA screenshots + puppeteer scripts
/.qa/
/qa-*.mjs

# typescript
*.tsbuildinfo
next-env.d.ts
